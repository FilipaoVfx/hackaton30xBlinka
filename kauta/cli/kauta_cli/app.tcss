/* Paleta de marca Kauta (ver prototipos/assets/kauta-brand.css) aplicada a la TUI. */
Screen {
    background: #0B1736;
    color: #F5F7FB;
}

.titulo {
    color: #9DADFF;
    text-style: bold;
}

.bien { color: #16C79A; }
.alerta { color: #FFB547; }
.mal { color: #FF5C5C; }
.tenue { color: #B5BFD3; }

/* Sin dock: dos widgets con `dock: top` se superponen en la misma fila y el
   menú de teclas queda invisible debajo de la barra. En flujo normal se apilan. */
BarraEstado {
    height: 1;
    background: #142343;
    color: #F5F7FB;
    padding: 0 1;
}

Menu {
    height: 1;
    background: #0B1736;
    color: #B5BFD3;
    padding: 0 1;
}

.panel {
    border: round #334364;
    padding: 1 2;
    background: #142343;
}

.panel > .panel-titulo {
    color: #9DADFF;
    text-style: bold;
}

DataTable {
    background: #142343;
}

DataTable > .datatable--cursor {
    background: #3B5BFD;
}

Sparkline {
    background: #142343;
}

Sparkline > .sparkline--max-color {
    color: #16C79A;
}

Sparkline > .sparkline--min-color {
    color: #334364;
}

OptionList {
    background: #142343;
    border: round #334364;
}

#modal-dialogo {
    align: center middle;
}

#modal-dialogo > Vertical {
    width: 60;
    height: auto;
    border: round #3B5BFD;
    background: #142343;
    padding: 1 2;
}
